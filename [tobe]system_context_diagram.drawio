        <mxCell id="p1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#3a8342;strokeColor=#2a6230;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;" value="Vendor / Contractor&#xa;[Person]&#xa;Completes factory work items.&#xa;Submits handover documents for audit.&#xa;Asks natural-language questions to find requirements, experts." vertex="1">
