        <mxCell id="e1" parent="grpnew" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#4f5256;strokeColor=#e0a300;strokeWidth=3;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;spacing=8;" value="Enterprise Content Sources&#xa;[Software System]&#xa;SharePoint. Confluence. File servers. Internal databases.&#xa;Corporate knowledge. Structured data." vertex="1">
