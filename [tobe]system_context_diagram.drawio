          <mxGeometry height="150" width="260" x="600" y="60" as="geometry" />
        </mxCell>
        <mxCell id="e5" parent="grpnew" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#4f5256;strokeColor=#e0a300;strokeWidth=3;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;spacing=8;" value="HR / Org Directory&#xa;[Software System]&#xa;Employee profiles.&#xa;Used for expert identification." vertex="1">
